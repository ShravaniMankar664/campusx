# Public Sepolia RPC endpoint used only by the Hardhat deployment script.
SEPOLIA_RPC_URL=

# Keep the deployer private key in Replit Secrets or a local ignored .env.local.
# Never prefix this value with VITE_ and never commit it.
DEPLOYER_PRIVATE_KEY=

# Public app configuration; set these after a verified deployment.
VITE_CAMPUSX_CONTRACT_ADDRESS=
VITE_CAMPUSX_DEPLOYMENT_BLOCK=
